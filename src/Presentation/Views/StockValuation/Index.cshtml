@model WorkspaceModel
<form class="filter-band" id="filters" method="get">
    <div class="field field-wide">
        <label for="item">Item ID</label>
        <input class="form-control" id="item" name="item" value="@Model.Item" required />
    </div>
    <div class="field">
        <label for="date">As-of date</label>
        <input class="form-control" type="date" id="date" name="date" value="@Model.Date" required />
    </div>
    <button class="btn btn-primary" name="apply" value="true"><partial name="_Icon" model='"layers"' /> Compute valuation</button>
</form>
<partial name="_Feedback" model="Model" />
@if (!Model.Applied && Model.Error == null)
{
    <div class="panel empty-state">
        <partial name="_Icon" model='"layers"' />
        <h2>Start with an item and a date</h2>
        <p>Enter an item ID to inspect the current FIFO layers.</p>
    </div>
}
@if (Model.Applied && Model.Available && Model.Error == null)
{
    <section data-results>
        <div class="section-heading">
            <h2>@Model.Metrics["name"] <span class="id-label">@Model.Item</span></h2><span>@Model.DateLabel</span>
        </div>
        <div class="metric-grid two-columns">
            <article class="metric">
                <p>Closing stock <span class="metric-icon"><partial name="_Icon" model='"warehouse"' /></span></p>
                <div class="metric-value">@Model.Metrics["quantity"] <span>@Model.Metrics["unit"]</span></div>
            </article>
            <article class="metric featured">
                <p>FIFO stock value <span class="metric-icon"><partial name="_Icon" model='"layers"' /></span></p>
                <div class="metric-value">@Model.Metrics["value"]</div>
            </article>
        </div>
        <section class="panel"><partial name="_Table" model="Model.PrimaryTable" /></section>
    </section>
}
