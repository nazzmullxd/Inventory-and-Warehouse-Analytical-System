@model WorkspaceModel
<form class="filter-band" method="get"><div class="field"><label for="start">Period start</label><input class="form-control" type="date" id="start" name="start" value="@Model.Start" required /></div><div class="field"><label for="end">Period end</label><input class="form-control" type="date" id="end" name="end" value="@Model.End" required /></div><div class="field"><label for="filter">Standing</label><select class="form-select" id="filter" name="filter"><option value="all" selected="@(Model.Filter == "all")">All suppliers</option><option value="watch" selected="@(Model.Filter == "watch")">Watch list</option><option value="good" selected="@(Model.Filter == "good")">Good</option><option value="excellent" selected="@(Model.Filter == "excellent")">Excellent</option></select></div><button class="btn btn-primary" name="apply" value="true">Analyze</button></form>
<partial name="_Feedback" model="Model" />
@if (Model.Available && Model.Error == null && Model.PrimaryTable != null) {<div data-results><div class="section-heading"><h2>Delivery reliability</h2><span>@Model.PeriodLabel</span></div><section class="panel"><partial name="_Table" model="Model.PrimaryTable" /></section><div class="notice neutral"><strong>Measure scope</strong><p>On-time ratio covers delivered purchase orders; average delay covers late orders only.</p></div></div>}
