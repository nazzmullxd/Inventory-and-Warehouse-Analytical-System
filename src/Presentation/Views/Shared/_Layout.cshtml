@model WorkspaceModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Title · IWAS</title>
    <link rel="stylesheet" href="~/vendor/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/typography.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main">Skip to main content</a>
<aside class="sidebar" aria-label="Workspace navigation">
    <a class="brand" href="/" aria-label="IWAS dashboard">
        <span class="brand-mark"><partial name="_Icon" model='"warehouse"' /></span>
        <span>IWAS<small>WAREHOUSE ANALYTICS</small></span>
    </a>
    <button class="nav-toggle btn btn-outline-light" type="button" aria-expanded="true" aria-controls="primary-nav">
        <partial name="_Icon" model='"menu"' /> Menu
    </button>
    <nav id="primary-nav" aria-label="Primary">
        <p class="nav-label">WORKSPACE</p>
        @{
            var links = new[] {
                ("Dashboard", "/", "Dashboard", "overview"),
                ("StockValuation", "/stock-valuation", "Stock Valuation", "layers"),
                ("Reorder", "/reorder", "Reorder and EOQ", "reorder"),
                ("Suppliers", "/suppliers/performance", "Supplier Performance", "supplier"),
                ("Matching", "/requisitions/matching", "Requisition Matching", "match"),
                ("Clarifications", "/requisitions/clarifications", "Clarification Needed", "clarify"),
                ("Reports", "/reports", "Reports", "report")
            };
        }
        @foreach (var (key, url, label, icon) in links)
        {
            var active = Model.Page == key || key == "Reports" && Model.Page == "Preview";
            <a href="@url" class="nav-item @(active ? "active" : "") @(key == "Clarifications" ? "nav-child" : "")" aria-current="@(active ? "page" : null)">
                <partial name="_Icon" model="icon" /> @label
            </a>
        }
    </nav>
    <div class="sidebar-note"><span class="live-dot" aria-hidden="true"></span> Operations workspace<p>Insights and reports.<br />Warehouse records stay intact.</p></div>
    <div class="workspace-identity"><span class="avatar">PT</span><span>Padma Trading Ltd<small>Dhaka operations</small></span></div>
</aside>
<div class="workspace">
    <header class="topbar"><div>Workspace <span aria-hidden="true">/</span> <strong>@(Model.Page == "Preview" ? "Reports" : Model.Title)</strong></div></header>
    <main id="main" tabindex="-1">
        <div class="page-heading">
            <div><p class="eyebrow">INVENTORY &amp; WAREHOUSE ANALYTICS</p><h1>@Model.Title</h1><p class="page-description">@Model.Description</p></div>
            @if (Model.Page == "Dashboard")
            {
                <a class="btn btn-outline-secondary" href="/reports"><partial name="_Icon" model='"report"' /> Browse reports</a>
            }
        </div>
        @RenderBody()
        <footer class="workspace-footer"><span>IWAS <span aria-hidden="true">·</span> Operations workspace</span><span>BDT currency · Asia/Dhaka date context</span></footer>
    </main>
</div>
<script src="~/js/shared/workspace.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
