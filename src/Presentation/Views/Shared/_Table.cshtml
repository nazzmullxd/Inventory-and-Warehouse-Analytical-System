@model DataTable
<p class="scroll-hint">Scroll horizontally to inspect all columns when needed.</p>
<div class="table-region" role="region" aria-label="@Model.Caption" tabindex="0">
<table class="table evidence-table">
    <caption>@Model.Caption</caption>
    <thead><tr>@foreach (var column in Model.Headers) {<th scope="col">@column</th>}</tr></thead>
    <tbody>
    @foreach (var row in Model.Rows)
    {
        <tr>@for (var i = 0; i < row.Length; i++) {
            if (i == 0) {<th scope="row">@row[i]</th>}
            else {
                var tone = row[i] is "Order 45 now" or "Clarification" or "Watch list" ? "warning" : row[i] is "Good" or "Excellent" or "OK" or "Priced, in stock" ? "success" : row[i] == "Order in 3 days" ? "info" : "";
                var numeric = char.IsDigit(row[i].FirstOrDefault()) || row[i].StartsWith("BDT ") || row[i].StartsWith("≈ ");
                <td class="@(numeric ? "numeric-cell" : null)">@if (tone != "") {<span class="status status-@tone">@row[i]</span>} else {@row[i]}</td>
            }
        }</tr>
    }
    </tbody>
    @if (Model.Footer != null) {<tfoot><tr><td colspan="@Model.Headers.Length">@Model.Footer</td></tr></tfoot>}
</table>
@if (Model.Rows.Length == 0) {<p class="empty-state">No records for these filters.</p>}
</div>
