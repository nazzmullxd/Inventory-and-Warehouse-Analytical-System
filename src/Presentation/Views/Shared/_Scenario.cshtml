@model WorkspaceModel
<details class="scenario-picker"><summary>Preview display states</summary><p>These options demonstrate supplied UI states; they do not run analysis.</p><label for="scenario">Display state</label><select id="scenario" name="scenario" class="form-select"><option value="success" selected="@(Model.Scenario == "success")">Sample results</option><option value="empty" selected="@(Model.Scenario == "empty")">Empty / zero</option><option value="partial" selected="@(Model.Scenario == "partial")">Partial results</option><option value="unavailable" selected="@(Model.Scenario == "unavailable")">Unavailable</option></select></details>
