@model WorkspaceModel
<form class="filter-band" id="filters" method="get">
    <div class="field"><label for="start">Period start</label><input class="form-control" type="date" id="start" name="start" value="@Model.Start" required /></div><div class="field"><label for="end">Period end</label><input class="form-control" type="date" id="end" name="end" value="@Model.End" required /></div><div class="field"><label for="date">Stock as-of date</label><input class="form-control" type="date" id="date" name="date" value="@Model.Date" required /></div>
    <div class="field"><label for="filter">Reason</label><select class="form-select" id="filter" name="filter"><option value="all" selected="@(Model.Filter == "all")">All reasons</option><option value="low" selected="@(Model.Filter == "low")">Low similarity</option><option value="tie" selected="@(Model.Filter == "tie")">Tied candidates</option><option value="none" selected="@(Model.Filter == "none")">No candidates / text</option></select></div>
    <button class="btn btn-primary" name="apply" value="true">View clarifications</button><a class="reset-link" href="/requisitions/clarifications">Reset</a><partial name="_Scenario" model="Model" />
</form>
<partial name="_Feedback" model="Model" />
@if (Model.Error == null && Model.Available && Model.Scenario != "unavailable") {
<div data-results><div class="notice neutral"><strong>External follow-up needed</strong><p>This is a computed, read-only list. Clarification happens outside IWAS; there is no resolution or approval action.</p></div>
    <section class="panel"><div class="panel-heading"><div><h2>Requisitions to inspect</h2><p>@Model.PeriodLabel · stock as of @Model.DateLabel</p></div></div>
    @if (Model.Scenario == "empty") {<p class="empty-state">No requisitions need clarification for these filters.</p>}
    else {
        var rows = DisplayFixtures.Matches.Where(x => x.Status == "Clarification" && (Model.Filter switch { "low" => x.Id == "RQ-0873", "tie" => x.Id == "RQ-0874", "none" => x.Id is "RQ-0875" or "RQ-0876", _ => true }));
        <div class="table-region" role="region" aria-label="Requisitions requiring clarification" tabindex="0"><table class="table evidence-table"><caption>Supplemental UI scenarios; distinct from the three-record R5 sample</caption><thead><tr><th scope="col">Requisition</th><th scope="col">Department / date</th><th scope="col">Source text</th><th scope="col">Best candidate</th><th scope="col">Similarity</th><th scope="col">Reason</th><th scope="col">Next step</th></tr></thead><tbody>@foreach (var m in rows) {<tr><th scope="row">@m.Id</th><td>@m.Department<small>08 Jul 2026</small></td><td class="narrative">@(m.Text == "" ? "Empty source text" : m.Text)</td><td>@m.Item</td><td>@m.Similarity</td><td class="narrative">@m.Reason</td><td><a href="/requisitions/matching?requisition=@m.Id&date=@Model.Date&apply=true&returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)">Inspect @m.Id →</a></td></tr>}</tbody></table></div>
    }
    </section>
</div>
}
