@model WorkspaceModel
<form class="filter-band" id="filters" method="get"><div class="field"><label for="start">Period start</label><input class="form-control" type="date" id="start" name="start" value="@Model.Start" required /></div><div class="field"><label for="end">Period end</label><input class="form-control" type="date" id="end" name="end" value="@Model.End" required /></div><div class="field"><label for="date">Stock date</label><input class="form-control" type="date" id="date" name="date" value="@Model.Date" required /></div><div class="field"><label for="filter">Reason</label><select class="form-select" id="filter" name="filter"><option value="all" selected="@(Model.Filter == "all")">All</option><option value="low" selected="@(Model.Filter == "low")">Low similarity</option><option value="tie" selected="@(Model.Filter == "tie")">Tied candidates</option><option value="none" selected="@(Model.Filter == "none")">No candidates / text</option></select></div><button class="btn btn-primary">View clarifications</button></form>
<partial name="_Feedback" model="Model" />
@if (Model.Available && Model.Error == null && Model.PrimaryTable != null) {<div data-results><div class="notice neutral"><strong>Follow-up required</strong><p>Review requisition details before approval.</p></div><section class="panel"><partial name="_Table" model="Model.PrimaryTable" /></section></div>}
