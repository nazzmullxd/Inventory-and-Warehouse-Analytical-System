@model WorkspaceModel
<form class="filter-band" id="filters" method="get">
    <div class="field"><label for="date">Analysis date</label><input class="form-control" type="date" id="date" name="date" value="@Model.Date" required /></div>
    <div class="field field-wide"><label for="filter">Recommendation / dead stock</label><select class="form-select" id="filter" name="filter"><option value="all" selected="@(Model.Filter == "all")">All recommendations</option><option value="now" selected="@(Model.Filter == "now")">Order now</option><option value="projected" selected="@(Model.Filter == "projected")">Projected order</option><option value="ok" selected="@(Model.Filter == "ok")">OK</option><option value="dead" selected="@(Model.Filter == "dead")">Dead stock</option></select></div>
    <button class="btn btn-primary" name="apply" value="true">Analyze reorder needs</button><a class="reset-link" href="/reorder">Reset</a><partial name="_Scenario" model="Model" />
</form>
<partial name="_Feedback" model="Model" />
@if (Model.Error == null && Model.Available && Model.Scenario != "unavailable") {
<div data-results>
    <div class="section-heading"><div><h2>@(Model.Filter == "dead" ? "Dead-stock review" : "Purchasing outlook")</h2><p>@Model.DateLabel · Recommendations only; no order is submitted.</p></div>@if (Model.Scenario == "success") {<a class="btn btn-outline-secondary" href="@Model.ReportUrl("R3")">View reorder report ↗</a>}</div>
    @if (Model.Scenario == "empty") {<div class="panel empty-state"><h2>No items for these filters</h2><p>Illustrative empty scope. Change or reset the filters to inspect the sample recommendations.</p></div>}
    else if (Model.Filter == "dead") {<section class="panel"><partial name="_Table" model="DisplayFixtures.DeadStock" /></section>}
    else {
        var rows = DisplayFixtures.Reorder.Rows.Where(r => Model.Filter switch { "now" => r[10] == "Order 45 now", "projected" => r[10] == "Order in 3 days", "ok" => r[10] == "OK", _ => true }).ToArray();
        <section class="panel"><div class="panel-heading"><div><h2>Item recommendations</h2><p>Supplied priority order · showing all @rows.Length matching sample items</p></div><span class="status status-info">Read-only</span></div><partial name="_Table" model="new DataTable(DisplayFixtures.Reorder.Caption, DisplayFixtures.Reorder.Headers, rows)" /></section>
        <details class="panel evidence-details"><summary>A4 Paper · demand and lead-time evidence</summary><dl class="context-list"><dt>Annual demand</dt><dd>3,650 reams · annualized source example; exact demand window not supplied</dd><dt>Base lead time</dt><dd>5 days · standalone M2 example</dd><dt>Supplier delay</dt><dd>Not included in this standalone example</dd><dt>Selected supplier</dt><dd>Not supplied; do not infer the M3 supplier</dd><dt>Ordering cost</dt><dd>BDT 800.00 per order</dd><dt>Holding cost</dt><dd>BDT 40.00 per ream per year</dd><dt>Safety stock contribution</dt><dd>10 reams · supplied example</dd></dl><a href="/suppliers/performance">Inspect the separate supplier example →</a></details>
    }
    <div class="notice neutral"><strong>About dead stock</strong><p>No issue in the last 180 days. Disposal recommendations are information for external review; source records remain read-only.</p></div>
</div>
}
