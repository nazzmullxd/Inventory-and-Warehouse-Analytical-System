@model WorkspaceModel
<div class="report-workspace"><nav class="report-list" aria-label="Report selection">@foreach (var r in WorkspaceModel.ReportTitles) {<a class="report-choice @(Model.Report == r.Key ? "selected" : "")" href="/reports?report=@r.Key"><span class="report-code">@r.Key</span><span>@r.Value<small>Ready to print</small></span><span>→</span></a>}</nav><section class="panel report-config"><p class="eyebrow">@Model.Report · REPORT PARAMETERS</p><h2>@WorkspaceModel.ReportTitles[Model.Report]</h2><form class="report-form" method="get" action="/reports/@Model.Report/preview">@if (Model.Report == "R4") {<div class="field"><label for="start">Supplier period start</label><input type="date" class="form-control" id="start" name="start" value="@Model.Start" required /></div><div class="field"><label for="end">Supplier period end</label><input type="date" class="form-control" id="end" name="end" value="@Model.End" required /></div>}<div class="field"><label for="date">Analysis date</label><input type="date" class="form-control" id="date" name="date" value="@Model.Date" required /></div><button class="btn btn-primary">Generate report</button></form></section></div>
