@model WorkspaceModel
<div class="report-workspace">
    <nav class="report-list" aria-label="Report selection">
        @foreach (var report in WorkspaceModel.ReportTitles)
        {
            <a class="report-choice @(Model.Report == report.Key ? "selected" : "")" href="/reports?report=@report.Key" aria-current="@(Model.Report == report.Key ? "true" : null)">
                <span class="report-code">@report.Key</span>
                <span>@report.Value<small>Ready to print</small></span>
                <partial name="_Icon" model='"arrow-right"' />
            </a>
        }
    </nav>
    <section class="panel report-config">
        <p class="eyebrow">@Model.Report · REPORT PARAMETERS</p>
        <h2>@WorkspaceModel.ReportTitles[Model.Report]</h2>
        <form class="report-form" method="get" action="/reports/@Model.Report/preview">
            @if (Model.Report == "R4")
            {
                <div class="field">
                    <label for="start">Supplier period start</label>
                    <input type="date" class="form-control" id="start" name="start" value="@Model.Start" required />
                </div>
                <div class="field">
                    <label for="end">Supplier period end</label>
                    <input type="date" class="form-control" id="end" name="end" value="@Model.End" required />
                </div>
            }
            <div class="field">
                <label for="date">Analysis date</label>
                <input type="date" class="form-control" id="date" name="date" value="@Model.Date" required />
            </div>
            <button class="btn btn-primary"><partial name="_Icon" model='"report"' /> Generate report</button>
        </form>
    </section>
</div>
